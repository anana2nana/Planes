rules_version = '2';

// 🔒 Solo vosotros dos podéis leer o escribir.
// ⚠️ Cambia estos emails por los vuestros (los mismos que en VITE_NITA_EMAIL / VITE_KITOS_EMAIL).
service cloud.firestore {
  match /databases/{database}/documents {

    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'nita@gmail.com',
          'kitos@gmail.com'
        ];
    }

    // Quién es quien (para lo privado de cada uno, como los regalos).
    function me() {
      return request.auth.token.email.lower() == 'nita@gmail.com' ? 'nita' : 'kitos';
    }

    function isValidPlan(p) {
      return p.title is string
        && p.title.size() > 0 && p.title.size() <= 200
        && p.assignee in ['nita', 'kitos', 'both']
        && p.priority in ['low', 'medium', 'high', 'urgent']
        && p.tagIds is list && p.tagIds.size() <= 20
        && p.done is bool
        && (p.dueAt == null || p.dueAt is timestamp);
    }

    function isValidTag(t) {
      return t.name is string && t.name.size() > 0 && t.name.size() <= 40
        && t.color is string && t.color.matches('^#[0-9a-fA-F]{6}$');
    }

    match /plans/{planId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && isValidPlan(request.resource.data);
    }

    match /tags/{tagId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && isValidTag(request.resource.data);
    }

    // Un documento por móvil con notificaciones activadas (id = token de FCM).
    match /devices/{token} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.person in ['nita', 'kitos']
        && request.resource.data.token == token;
    }

    match /config/{docId} {
      allow read, write: if isCouple();
    }

    // Casa (cooperativa MEROE): configuración, plan de pagos y ahorros.
    match /home/{docId} {
      allow read, write: if isCouple();
    }

    match /homeItems/{itemId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.amount.value is number;
    }

    match /homeFunds/{fundId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.amount is number
        && request.resource.data.owner in ['nita', 'kitos', 'both'];
    }

    // Lista de la compra.
    match /shopping/{itemId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.done is bool;
    }

    // Fotos de tickets (JPEG comprimido en el propio documento, máx. ~1 MB).
    match /receipts/{receiptId} {
      allow read, delete: if isCouple();
      allow create: if isCouple()
        && request.resource.data.itemId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }

    // Ideas para "algún día".
    match /ideas/{ideaId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
    }

    // La gata: ficha (pet/profile) y cuidados periódicos.
    match /pet/{docId} {
      allow read, write: if isCouple();
    }
    match /petCare/{careId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }

    // Notas de casa (wifi, tallas, teléfonos…).
    match /notes/{noteId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
    }

    // 🤫 Ideas de regalo: cada uno solo ve y toca las suyas (ni siquiera la pareja puede leerlas).
    match /gifts/{giftId} {
      allow read, delete: if isCouple() && resource.data.owner == me();
      allow create: if isCouple()
        && request.resource.data.owner == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
      allow update: if isCouple()
        && resource.data.owner == me()
        && request.resource.data.owner == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
    }

    // Menú de la semana (id = fecha_comida|cena) y recetario.
    match /meals/{mealId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.slot in ['comida', 'cena']
        && mealId == request.resource.data.date + '_' + request.resource.data.slot
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100;
    }
    // HTML original de las recetas importadas (aparte, para que la lista pese poco).
    match /recipeHtml/{recipeId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.html is string && request.resource.data.html.size() <= 700000;
    }
    match /recipes/{recipeId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 100;
    }

    // Diario: recuerdos (con miniatura) y sus fotos a tamaño completo, aparte.
    match /memories/{memoryId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.date is string;
    }
    match /memoryPhotos/{photoId} {
      allow read, delete: if isCouple();
      allow create: if isCouple()
        && request.resource.data.memoryId is string
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    // Foto de perfil: la ven los dos; cada uno cambia la suya.
    match /profiles/{person} {
      allow read: if isCouple();
      allow write: if isCouple() && person == me()
        && (request.resource == null || request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 200000));
    }

    // Contraseña de regalos de cada uno: solo la sal y una comprobación (nunca la clave).
    match /giftKeys/{person} {
      allow read, write: if isCouple() && person == me();
    }

    // Salud: rutinas y entrenos (los ven los dos; cada uno toca los suyos).
    match /routines/{routineId} {
      allow read: if isCouple();
      allow delete: if isCouple() && resource.data.owner == me();
      allow create, update: if isCouple()
        && request.resource.data.owner == me()
        && (resource == null || resource.data.owner == me())
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.exercises is list && request.resource.data.exercises.size() <= 40;
    }
    match /workouts/{workoutId} {
      allow read: if isCouple();
      allow delete: if isCouple() && resource.data.owner == me();
      allow create, update: if isCouple()
        && request.resource.data.owner == me()
        && (resource == null || resource.data.owner == me())
        && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 40;
    }
    // ⚖️ Peso y medidas: cada uno solo ve los suyos.
    match /bodyLogs/{logId} {
      allow read, delete: if isCouple() && resource.data.owner == me();
      allow create, update: if isCouple()
        && request.resource.data.owner == me()
        && (resource == null || resource.data.owner == me())
        && request.resource.data.date is string;
    }

    // Hemeroteca: pelis, series, libros… (la portada puede ser una foto pequeña).
    match /media/{mediaId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && (request.resource.data.cover == null || (request.resource.data.cover is string && request.resource.data.cover.size() < 300000));
    }
    // Sitios: restaurantes y planes.
    match /spots/{spotId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
    }
    // Rutas (paseos y senderismo): hechas o por hacer, con el camino como polilínea.
    match /routes/{routeId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && (!('polyline' in request.resource.data) || (request.resource.data.polyline is string && request.resource.data.polyline.size() < 200000));
    }
    // Garantías, documentos, seguros… y su foto (aparte, para que la lista pese poco).
    match /papers/{paperId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }
    match /paperPhotos/{paperId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    // Viajes (con reservas, maleta y gastos dentro), banda sonora e hitos.
    match /trips/{tripId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }
    match /songs/{songId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100;
    }
    match /milestones/{milestoneId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.date is string;
    }

    // 💌 Cápsula del tiempo: el sobre lo ven los dos; la carta, quien la escribe y,
    // a partir de su fecha, a quien va dirigida (ni antes, ni desde la consola de la app).
    match /capsules/{capsuleId} {
      allow read: if isCouple();
      allow create: if isCouple()
        && request.resource.data.from == me()
        && request.resource.data.to in ['nita', 'kitos', 'both']
        && request.resource.data.to != me()
        && request.resource.data.openAtTs is timestamp;
      allow update: if isCouple() && (
        (resource.data.from == me() && request.resource.data.from == me() && request.resource.data.to != me())
        || ((resource.data.to == me() || resource.data.to == 'both') && resource.data.from != me()
            && request.time >= resource.data.openAtTs
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])));
      allow delete: if isCouple() && resource.data.from == me();
    }
    match /capsuleLetters/{capsuleId} {
      allow read: if isCouple() && (
        resource.data.from == me()
        || ((resource.data.to == me() || resource.data.to == 'both')
            && request.time >= get(/databases/$(database)/documents/capsules/$(capsuleId)).data.openAtTs));
      allow create, update: if isCouple()
        && request.resource.data.from == me()
        && (resource == null || resource.data.from == me())
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000;
      allow delete: if isCouple() && resource.data.from == me();
    }

    // Mantenimiento (casa y coche) y suscripciones.
    match /upkeep/{upkeepId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }
    match /subs/{subId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.price is number;
    }

    // 🩺 Salud: cada uno solo ve lo suyo (citas, vacunas, medicación y su ficha).
    match /health/{healthId} {
      allow read, delete: if isCouple() && resource.data.owner == me();
      allow create, update: if isCouple()
        && request.resource.data.owner == me()
        && (resource == null || resource.data.owner == me())
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }
    match /healthProfile/{person} {
      allow read, write: if isCouple() && person == me();
    }

    // Euríbor: lo escribe solo el servidor (Cloud Functions).
    match /rates/{docId} {
      allow read: if isCouple();
    }
  }
}
