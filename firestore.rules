rules_version = '2';

// 🔒 Solo vosotros dos podéis leer o escribir.
// ⚠️ Cambia estos emails por los vuestros (los mismos que en VITE_NITA_EMAIL / VITE_KITOS_EMAIL).
service cloud.firestore {
  match /databases/{database}/documents {

    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'nita@gmail.com',
          'kitos@gmail.com'
        ];
    }

    // Quién es quien (para lo privado de cada uno, como los regalos).
    function me() {
      return request.auth.token.email.lower() == 'nita@gmail.com' ? 'nita' : 'kitos';
    }

    function isValidPlan(p) {
      return p.title is string
        && p.title.size() > 0 && p.title.size() <= 200
        && p.assignee in ['nita', 'kitos', 'both']
        && p.priority in ['low', 'medium', 'high', 'urgent']
        && p.tagIds is list && p.tagIds.size() <= 20
        && p.done is bool
        && (p.dueAt == null || p.dueAt is timestamp);
    }

    function isValidTag(t) {
      return t.name is string && t.name.size() > 0 && t.name.size() <= 40
        && t.color is string && t.color.matches('^#[0-9a-fA-F]{6}$');
    }

    match /plans/{planId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && isValidPlan(request.resource.data);
    }

    match /tags/{tagId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && isValidTag(request.resource.data);
    }

    // Un documento por móvil con notificaciones activadas (id = token de FCM).
    match /devices/{token} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.person in ['nita', 'kitos']
        && request.resource.data.token == token;
    }

    match /config/{docId} {
      allow read, write: if isCouple();
    }

    // Casa (cooperativa MEROE): configuración, plan de pagos y ahorros.
    match /home/{docId} {
      allow read, write: if isCouple();
    }

    match /homeItems/{itemId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.amount.value is number;
    }

    match /homeFunds/{fundId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.amount is number
        && request.resource.data.owner in ['nita', 'kitos', 'both'];
    }

    // Lista de la compra.
    match /shopping/{itemId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.done is bool;
    }

    // Fotos de tickets (JPEG comprimido en el propio documento, máx. ~1 MB).
    match /receipts/{receiptId} {
      allow read, delete: if isCouple();
      allow create: if isCouple()
        && request.resource.data.itemId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }

    // Ideas para "algún día".
    match /ideas/{ideaId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
    }

    // La gata: ficha (pet/profile) y cuidados periódicos.
    match /pet/{docId} {
      allow read, write: if isCouple();
    }
    match /petCare/{careId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
    }

    // Notas de casa (wifi, tallas, teléfonos…).
    match /notes/{noteId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
    }

    // 🤫 Ideas de regalo: cada uno solo ve y toca las suyas (ni siquiera la pareja puede leerlas).
    match /gifts/{giftId} {
      allow read, delete: if isCouple() && resource.data.owner == me();
      allow create: if isCouple()
        && request.resource.data.owner == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
      allow update: if isCouple()
        && resource.data.owner == me()
        && request.resource.data.owner == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
    }

    // Menú de la semana (id = fecha_comida|cena) y recetario.
    match /meals/{mealId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.slot in ['comida', 'cena']
        && mealId == request.resource.data.date + '_' + request.resource.data.slot
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100;
    }
    // HTML original de las recetas importadas (aparte, para que la lista pese poco).
    match /recipeHtml/{recipeId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.html is string && request.resource.data.html.size() <= 700000;
    }
    match /recipes/{recipeId} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 100;
    }

    // Euríbor: lo escribe solo el servidor (Cloud Functions).
    match /rates/{docId} {
      allow read: if isCouple();
    }
  }
}
