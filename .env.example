# ── Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging → Configuración web → Certificados push web → "Generar par de claves"
VITE_FIREBASE_VAPID_KEY=

# ── Quién es quién (emails de las cuentas de Google con las que entraréis)
# Deben coincidir con los de firestore.rules
VITE_NITA_EMAIL=nita@gmail.com
VITE_KITOS_EMAIL=kitos@gmail.com

# ── Opcional: usar los emuladores locales de Firebase en `npm run dev`
# VITE_USE_EMULATORS=true
